@using NetCoreERPSysWeb.Models
@model List<Product>
@{
    ViewData["Title"] = "Product";
}

<partial name="_Notification" />

<div class="row pt-4">
    <div class="col-6">
        <h2 class="text-primary">
            Product List
        </h2>
    </div>
    <div class="col-6 text-end">
        <a asp-controller="Product" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-patch-plus"></i> Create New Product
        </a>
    </div>
</div>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>ISBN</th>
            <th>Price</th>
            <th>Author</th>
            <th>Category</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var obj in Model)
        {
            <tr>
                <td>@obj.Title</td>
                <td>@obj.ISBN</td>
                <td>@obj.Price.ToString("C")</td>
                <td>@obj.Author</td>
                <td>
                    <div class="w-75 btn-group" role="group">
                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-dark mx-2">
                            <i class="bi bi-pencil-square">Edit</i>
                        </a>
                        <a asp-controller="Product" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-danger mx-2">
                            <i class="bi bi-trash-fill">Delete</i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>