@model NetCoreERPSys.Models.ViewModels.ProductVM

@* enctype="multipart/form-data" 上传功能才能成功 *@
<form method="post" class="row" enctype="multipart/form-data">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Create Product</h2>
            <hr />
        </div>
        @*
            ModelOnly: 只显示那些不与任何特定字段相关联的“模型级别”错误.
            All: 所有字段级别的错误, 比如 Description 字段的 [Range] 错误等.
            None: 不显示任何错误.
        *@
        <div asp-validation-summary="ModelOnly" class="text-bg-warning">asp-validation-summary</div>
        <div class="mb-3">
            <label asp-for="Product.Title"></label>
            <input asp-for="Product.Title" class="form-control" />
            <span asp-validation-for="Product.Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.Description"></label>
            <textarea asp-for="Product.Description" rows="3" class="form-control"></textarea>
            <span asp-validation-for="Product.Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for=Product.ISBN"></label>
            <input asp-for="Product.ISBN" rows="3" class="form-control" />
            <span asp-validation-for="Product.ISBN" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.Author"></label>
            <input asp-for="Product.Author" rows="3" class="form-control" />
            <span asp-validation-for="Product.Author" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.ListPrice"></label>
            <input asp-for="Product.ListPrice" rows="3" class="form-control" />
            <span asp-validation-for="Product.ListPrice" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.Price"></label>
            <input asp-for="Product.Price" rows="3" class="form-control" />
            <span asp-validation-for="Product.Price" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.Price50"></label>
            <input asp-for="Product.Price50" rows="3" class="form-control" />
            <span asp-validation-for="Product.Price50" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.Price100"></label>
            <input asp-for="Product.Price100" rows="3" class="form-control" />
            <span asp-validation-for="Product.Price100" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.Price100"></label>
            <input asp-for="Product.Price100" rows="3" class="form-control" />
            <span asp-validation-for="Product.Price100" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Product.ImageUrl"></label>
            <input type="file" asp-for="Product.ImageUrl" rows="3" class="form-control" />
            <span asp-validation-for="Product.ImageUrl" class="text-danger"></span>
        </div>
        <div class="py-2 clo-12">
            <label asp-for="@Model.Product.CategoryId" class="ms-2"></label>
            @* <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" calss="form-select border-0 shadow"> *@
            @* <select asp-for="Product.CategoryId" asp-items="@(ViewData["CategoryList"]) as IEnumerable<SelectListItem>" calss="form-select border-0 shadow"> *@
            <select asp-for="@Model.Product.CategoryId" asp-items="@Model.CategoryList" calss="form-select border-0 shadow">
                <option disabled selected>--Select Category--</option>
            </select>
            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
        </div>
        <div class="row p-1">
            <div class="col-6"><button type="submit" class="btn btn-primary form-control">Create</button></div>
            <div class="col-6">
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark form-control">Back to List</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @*
        客户端验证的局限性:
        1. 需要在 Models 类上使用数据注解来定义规则: [Range(1, 100)].
        2. 需要 <input asp-for="..."> Tag helper 生成输入框.
        3. 仅能验证上述错误, 客户端的 JavaScript 脚本对自定义业务逻辑一无所知, 无法验证.

        优点: 客户端验证通过 JS脚本, 不跳转页面 不提交请求.
    *@
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}