@model Product

@*
    当一个 <form> 标签没有指定 action 属性时, 浏览器会默认将表单提交到当前页面的 URL. 例如 /Product/Delete/5
    框架接收到 /Product/Delete/5 的 POST 请求. 因此没有 <input asp-for="Id" hidden /> 也能成功删除.
*@
<form method="post" asp-action="Delete">
    @* 发起 HTTP POST 请求, 假设地址是/Product/Delete/5 *@
    @* 使用隐藏字段来传递需要删除的记录的 Id *@
    @* <input asp-for="Id" hidden /> *@
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Delete</h2>
            <hr />
        </div>
        <div asp-validation-summary="ModelOnly" class="text-bg-warning">asp-validation-summary</div>
        <div class="mb-3">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" disabled />
        </div>
        <div class="mb-3">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="3" class="form-control" disabled></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="ISBN"></label>
            <input asp-for="ISBN" rows="3" class="form-control" disabled />
        </div>
        <div class="mb-3">
            <label asp-for="Author"></label>
            <input asp-for="Author" rows="3" class="form-control" disabled />
        </div>
        <div class="mb-3">
            <label asp-for="ListPrice"></label>
            <input asp-for="ListPrice" rows="3" class="form-control" disabled />
        </div>
        <div class="mb-3">
            <label asp-for="Price"></label>
            <input asp-for="Price" rows="3" class="form-control" disabled />
        </div>
        <div class="mb-3">
            <label asp-for="Price50"></label>
            <input asp-for="Price50" rows="3" class="form-control" disabled />
        </div>
        <div class="mb-3">
            <label asp-for="Price100"></label>
            <input asp-for="Price100" rows="3" class="form-control" disabled />
        </div>        <div class="row p-1">
            <div class="col-6"><button type="submit" class="btn btn-danger form-control">Delete</button></div>
            <div class="col-6">
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark form-control">Back to List</a>
            </div>
        </div>
    </div>
</form>